# CodeConnect Hub - Frontend Environment Configuration
# Copy this file to .env and fill in your backend URL

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_TIMEOUT=30000

# Frontend URL (for OAuth redirects)
REACT_APP_FRONTEND_URL=http://localhost:8080

# Feature Flags
REACT_APP_ENABLE_OAUTH=false
REACT_APP_ENABLE_PAYMENT=false
REACT_APP_ENABLE_ANALYTICS=false

# Environment
REACT_APP_ENV=development
